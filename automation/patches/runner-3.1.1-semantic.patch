+def kind_for(element: dict) -> str:
+    explicit_raw = str(element.get("renderKind") or element.get("visualKind") or "").strip()
+    if explicit_raw:
+        explicit = normalize_kind_text(explicit_raw)
+        explicit = RENDER_KIND_ALIASES.get(explicit, explicit)
+        explicit = explicit.replace(" ", "-") if explicit.replace(" ", "-") in SUPPORTED_KINDS else explicit
+        if explicit not in SUPPORTED_KINDS:
+            raise RuntimeError(f"JOB_CONTRACT_ERROR: unsupported renderKind '{explicit_raw}'")
+        return explicit
+
+    # mustRenderAs is the semantic contract and takes priority over labels/ids.
+    must = element.get("mustRenderAs")
+    if isinstance(must, list):
+        for item in must:
+            inferred = infer_kind_from_text(item)
+            if inferred:
+                return inferred
+    elif must:
+        inferred = infer_kind_from_text(must)
+        if inferred:
+            return inferred
+
+    for key in ("label", "anchorText", "visualWhy", "imagePrompt", "id"):
+        inferred = infer_kind_from_text(element.get(key))
+        if inferred:
+            return inferred
     return "abstract"
 
 
+def expected_kind_for(element: dict) -> str | None:
+    explicit_raw = str(element.get("renderKind") or element.get("visualKind") or "").strip()
+    if explicit_raw:
+        return kind_for(element)
+    must = element.get("mustRenderAs")
+    if isinstance(must, list):
+        for item in must:
+            inferred = infer_kind_from_text(item)
+            if inferred:
+                return inferred
+    elif must:
+        return infer_kind_from_text(must)
+    return None
